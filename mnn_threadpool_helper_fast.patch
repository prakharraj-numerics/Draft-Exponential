+void ThreadPool::enqueueHelperOnly(TASK* taskp, int index) {
+    if (index < 0 || mNumberThread < 2 || mActiveCount == 0) {
+        taskp->first(1);
+        return;
+    }
+    mTasks[index].first = taskp;
+    *mTasks[index].second[1] = true;
+}
+
+void ThreadPool::waitHelperOnly(int index) {
+    if (index < 0 || mNumberThread < 2 || mActiveCount == 0) {
+        return;
+    }
+    while (*mTasks[index].second[1]) {
+#if defined(__x86_64__) || defined(__i386__)
+        __asm__ __volatile__("pause" ::: "memory");
+#else
+        std::this_thread::yield();
+#endif
+    }
+}
